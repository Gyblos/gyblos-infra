# Copy to .env on each VPS (never commit .env).
# Per relay: the DNS name that points at THIS VPS.
RELAY_HOSTNAME=na1.relay.gyblos.com
ACME_CONTACT=ops@example.com
# shared_token (recommended v1) | open
RELAY_ACCESS_MODE=shared_token
# Comma-separated; generate with: openssl rand -base64 48 | tr '+/' '-_' | tr -d '='
# Keep current,next during a rotation window; same value on both relays.
RELAY_ACCESS_TOKENS=replace-with-generated-token-at-least-32-chars
RUST_LOG=warn
